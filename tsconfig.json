{
    "$schema": "https://json.schemastore.org/tsconfig",
    "compilerOptions": {
        "target": "ES2017",
        "moduleResolution": "NodeNext",
        "module": "NodeNext",
        "inlineSourceMap": true,
        "inlineSources": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "strict": true,
        "experimentalDecorators": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "outDir": "./dist",
        "rootDir": "./source"
    },
    "include": [
        "source/**/*"
    ],
    "exclude": [
        "node_modules",
        "../node_modules"
    ]
}